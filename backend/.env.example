# ============================================================
# PSD 展示台后端 · 环境变量示例
# 用法：复制为 .env 后按需修改；.env 已被 .gitignore 忽略。
# 未设置的项一律使用下面的默认值。
# ============================================================

# 运行环境：development | production | test
# 影响日志样式（development 下彩色可读，其它为 JSON 行）与错误细节
NODE_ENV=development

# HTTP 监听地址。0.0.0.0 = 允许局域网/容器外部访问；127.0.0.1 = 仅本机
HOST=0.0.0.0

# HTTP 监听端口（前端开发态 Vite 代理 /api 到 http://localhost:4000）
PORT=4000

# 数据目录：存放 db.json、projects/<id>/ 与上传临时目录 tmp/
# 相对路径以 backend/ 为基准解析；生产建议用绝对路径挂载独立磁盘
DATA_DIR=./data

# 对外可访问的站点基址（用于反代/生成绝对链接），留空表示同源相对路径
PUBLIC_BASE_URL=

# CORS 允许的来源：* 表示允许全部；多来源用英文逗号分隔的白名单
CORS_ORIGIN=*

# 单个上传图片（PNG）最大体积，单位 MB，超出返回 413
# v2.0 起从 512 降到 20：不再上传几百 MB 的 PSD，只上传一张展示用 PNG，
# 源文件（PSD 等）由用户自行放到网盘，本站只保存分享链接，无需大带宽/大磁盘
MAX_UPLOAD_MB=20

# 上传令牌：保护 POST /api/projects 的**自动化旁路**（CI / 部署脚本用）
# 客户端用请求头 x-upload-token 提交；留空 = 关闭该旁路（v2.1 起 Authorization 头
# 已让给主站登录令牌，不再接受 Authorization: Bearer <上传令牌>）
UPLOAD_TOKEN=

# 管理令牌：保护 PATCH /api/projects/:id、DELETE /api/projects/:id
# 客户端用请求头 x-admin-token 或 Authorization: Bearer <token> 提交。留空 = 不校验
ADMIN_TOKEN=

# ---------------- v2.1 主站登录（契约 §8）----------------

# 主站基址（例 https://7thcv.cn），不带尾斜杠。
# 留空 = 不启用主站登录：上传只认 x-upload-token；两者都没配时上传不做鉴权（仅本地开发）
MAIN_SITE_BASE_URL=

# 校验登录令牌用的**成员专属**路径（本服务不持有主站 JWT 密钥，靠调用主站接口验令牌）
MAIN_SITE_VERIFY_PATH=/api/kb/tree

# 调用主站接口的超时（毫秒）；超时按「主站不可用」处理（失败关闭，不放行）
UPSTREAM_TIMEOUT_MS=8000

# 登录/校验端点（POST /api/auth/login、GET /api/auth/me）的独立限流：每 IP 每窗口上限
# 登录接口容易被爆破，默认 10 次/分钟（窗口长度沿用 RATE_LIMIT_WINDOW_MS）
LOGIN_RATE_LIMIT_MAX=10

# 挂载前缀（契约 §8.4）：与主站同源部署在 https://7thcv.cn/psd/ 时设为 /psd
# 留空 = 挂在根路径（行为与 v2.0 一致）；设置后 / 与 /psd 都会 302 到 /psd/
MOUNT_PREFIX=

# 信任的代理层数：部署在 Nginx/网关之后设 1（用于取真实客户端 IP 做限流）；
# 直接暴露公网时设为 false/0，避免伪造 X-Forwarded-For 绕过限流
TRUST_PROXY=1

# 全局限流窗口长度（毫秒），默认 60000 = 1 分钟
RATE_LIMIT_WINDOW_MS=60000

# 全局每个 IP 在窗口内的最大请求数，超出返回 429 + Retry-After
RATE_LIMIT_MAX=300

# 上传类接口（POST /api/projects）每个 IP 的窗口内上限
UPLOAD_RATE_LIMIT_MAX=30

# 是否由后端托管前端构建产物（单进程部署时设 true）
SERVE_STATIC=false

# 静态站点目录（SERVE_STATIC=true 时生效）：/assets/* 长缓存，其它路径回退 index.html
STATIC_DIR=../frontend/dist

# 文件存储驱动：local（本地磁盘）| s3（对象存储，需自行安装 @aws-sdk/client-s3）
STORAGE_DRIVER=local

# 以下 6 项仅在 STORAGE_DRIVER=s3 时生效
# S3 兼容服务端点，如 https://s3.us-east-1.amazonaws.com 或 MinIO 地址；留空用官方默认
S3_ENDPOINT=
# S3 区域，例如 us-east-1
S3_REGION=
# S3 桶名（必需）
S3_BUCKET=
# S3 访问密钥 ID
S3_ACCESS_KEY_ID=
# S3 访问密钥 Secret
S3_SECRET_ACCESS_KEY=
# true = path-style 寻址（MinIO/Ceph 等自建服务通常需要）
S3_FORCE_PATH_STYLE=false
# 对象存储的公网基址（用于生成直链），留空则走后端代理下发
S3_PUBLIC_BASE_URL=

# 日志级别：debug | info | warn | error | silent
LOG_LEVEL=info
