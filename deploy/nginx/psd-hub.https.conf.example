# =============================================================================
# PSD 展示台 · HTTPS（Let's Encrypt）配置模板
#
# 使用步骤（Docker 一体化方式）：
#   1) 先在 .env 里设置 DOMAIN 与 LETSENCRYPT_EMAIL
#   2) 用 HTTP 配置把站点跑起来：docker compose --profile edge up -d
#   3) 申请证书：
#        docker compose --profile tls run --rm certbot
#   4) 把这个文件另存为 deploy/nginx/psd-hub.conf（覆盖原文件），
#      或把它 drop 到 /etc/nginx/conf.d/ 下，然后 nginx -s reload
#   5) 续期（加进 crontab，每月 1 号执行）：
#        0 3 1 * * cd /opt/psd-hub && docker compose --profile tls run --rm certbot renew \
#                  && docker compose exec nginx nginx -s reload
#
# 证书路径按「certbot 容器把 ./deploy/nginx/certs 挂到 /etc/letsencrypt」来写，
# 主机的 ./deploy/nginx/certs/live/<域名>/ 里能看到同一批文件。
# =============================================================================

upstream psd_hub_backend_tls {
    server psd-hub:4000;          # 裸机部署请改为 127.0.0.1:4000
    keepalive 32;
}

# HTTP 全量跳转到 HTTPS（保留 ACME challenge 路径给 certbot 用）
server {
    listen      80;
    listen      [::]:80;
    server_name psd.example.com;   # ← 改成你的域名

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name psd.example.com;   # ← 改成你的域名

    server_tokens off;

    # --- 证书 ---
    ssl_certificate     /etc/nginx/certs/live/psd.example.com/fullchain.pem;   # ← 改域名
    ssl_certificate_key /etc/nginx/certs/live/psd.example.com/privkey.pem;     # ← 改域名
    ssl_trusted_certificate /etc/nginx/certs/live/psd.example.com/chain.pem;

    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_ciphers               ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;
    ssl_stapling              on;
    ssl_stapling_verify       on;

    # --- 大文件 ---
    client_max_body_size    600m;
    client_body_timeout     600s;
    client_body_buffer_size 1m;
    proxy_request_buffering off;
    proxy_buffering         off;
    proxy_connect_timeout   30s;
    proxy_read_timeout      600s;
    proxy_send_timeout      600s;
    send_timeout            600s;

    # --- 安全响应头（HTTPS 下才加 HSTS）---
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options           "SAMEORIGIN" always;

    gzip            on;
    gzip_vary       on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_proxied    any;
    gzip_types      text/plain text/css text/xml application/json application/javascript
                    text/javascript image/svg+xml application/wasm;

    location = /nginx-health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location /assets/ {
        proxy_pass         http://psd_hub_backend_tls;
        proxy_http_version 1.1;
        proxy_set_header   Connection "";
        proxy_set_header   Host $host;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location / {
        proxy_pass         http://psd_hub_backend_tls;
        proxy_http_version 1.1;
        proxy_set_header   Connection        "";
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Forwarded-Host  $host;
        proxy_set_header   X-Forwarded-Port  $server_port;
        proxy_hide_header  X-Powered-By;
    }
}
