# =============================================================================
# PSD 展示台 · 后端环境变量（systemd / 裸机部署用）
#
#   sudo cp deploy/systemd/psd-hub.env.example /etc/psd-hub/psd-hub.env
#   sudo chmod 600 /etc/psd-hub/psd-hub.env
#   sudo systemctl restart psd-hub
#
# 该文件与仓库根目录的 .env（docker compose 用）变量名完全一致，
# 区别只在于路径：这里是**服务器上的绝对路径**。
# =============================================================================

NODE_ENV=production
LOG_LEVEL=info

HOST=127.0.0.1
PORT=4000
# 反代在宿主机 Nginx，因此绑定回环即可；后端仍需信任代理头来取真实 IP
TRUST_PROXY=1

# 运行时数据目录（PSD 工程 / PNG / db.json）——systemd 单元里已授权可写
DATA_DIR=/var/lib/psd-hub

# 由本进程同时托管前端产物（单进程部署，最简单）
SERVE_STATIC=true
STATIC_DIR=/opt/psd-hub/frontend/dist

# ------------------------------ 上传与限流 ------------------------------
# v2.0 起只上传 PNG 展示图，20 MB 足够（原为 512 MB，那是上传 PSD 时代的设置）
MAX_UPLOAD_MB=20
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
UPLOAD_RATE_LIMIT_MAX=30

# ------------------------------ 访问控制 ------------------------------
# 生产环境强烈建议都设置成随机长字符串：
#   openssl rand -hex 32
UPLOAD_TOKEN=
ADMIN_TOKEN=

# 同源部署留 * 即可；前后端分离部署填前端域名（逗号分隔多个）
CORS_ORIGIN=*

# ------------------------------ 存储驱动 ------------------------------
STORAGE_DRIVER=local

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=

# 可选：对外访问基址（后端生成绝对链接时使用），例如 https://psd.example.com
PUBLIC_BASE_URL=
