# =============================================================================
# PSD 展示台 · 部署环境变量模板
#
#   cp deploy/env.example .env     # docker compose 会自动读取仓库根目录的 .env
#
# 后端进程自身也会读同名变量（backend/.env.example 是更完整的后端视角模板），
# 两边名字完全一致，因此同一份 .env 既能给 compose 用，也能给裸机 systemd 用。
# =============================================================================

# ------------------------------ 基础运行 ------------------------------
NODE_ENV=production
LOG_LEVEL=info

# 应用容器暴露给宿主机的地址与端口
# 只绑回环 = 由宿主机 Nginx 反代（推荐）；想直接对外改成 0.0.0.0
PSD_HUB_BIND=127.0.0.1
PSD_HUB_PORT=4000

# 镜像名与标签（CI 推送镜像时会被覆盖）
PSD_HUB_IMAGE=psd-hub
PSD_HUB_VERSION=1.0.0

# 可选：一体化 Nginx 的对外端口
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# 可选：申请 Let's Encrypt 证书时使用
DOMAIN=psd.example.com
LETSENCRYPT_EMAIL=admin@example.com

# ------------------------------ 上传限制 ------------------------------
# 单张展示图（PNG）的最大体积（MB）——Nginx 的 client_max_body_size 必须 >= 这个值
# v2.0 起站内只上传 PNG 展示图（源文件走网盘），20 MB 足够；
# 不再上传几百 MB 的 PSD，因此无需再为超大请求体调优 Nginx。
MAX_UPLOAD_MB=20

# ------------------------------ 访问控制 ------------------------------
# 留空 = 不校验（仅建议在内网/演示环境使用）
# 设置后：上传接口需要 x-upload-token，删除/改信息接口需要 x-admin-token
UPLOAD_TOKEN=
ADMIN_TOKEN=

# 允许跨域的来源，* 表示全部；前后端分离部署时填前端域名，逗号分隔
CORS_ORIGIN=*

# ------------------------------ 限流 ------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
UPLOAD_RATE_LIMIT_MAX=30
# 登录接口的独立限流（更严，防爆破）
LOGIN_RATE_LIMIT_MAX=10

# --------------------- v2.1 主站登录接入（可选）---------------------
# 复用主站（柒世纪视频组）的账号体系：只有登录且为社团成员的用户才能上传作品，
# 作者名强制取自登录用户名。留空 MAIN_SITE_BASE_URL 即关闭登录（上传回到不校验状态）。
MAIN_SITE_BASE_URL=
# 用来校验令牌的「成员专属」接口：服务端会带着用户的 Authorization 去调它。
# 200 = 有效成员；401 = 令牌无效；403 = 不是成员。
# 默认用主站知识库的读接口，因为它是主站唯一「只读 + 仅成员」的端点。
MAIN_SITE_VERIFY_PATH=/api/kb/tree
# 调用主站的超时（毫秒）
UPSTREAM_TIMEOUT_MS=8000

# --------------------- 挂载在子路径下（可选）---------------------
# 设为 /psd 即把整个应用挂在 https://<你的域名>/psd/ 下，
# 这样与主站同源、可以复用主站证书，登录密码也就不必走明文 HTTP。
# 注意：前端需要配套地以 VITE_BASE_PATH=/psd/ 与 VITE_API_BASE=/psd 构建（compose 会自动传）。
MOUNT_PREFIX=
VITE_BASE_PATH=/
VITE_API_BASE=

# ------------------------------ 存储驱动 ------------------------------
# local = 存容器内 /data（默认，简单可靠）
# s3    = 存 S3 / 阿里云 OSS / MinIO 等兼容对象存储（需要额外安装 @aws-sdk/client-s3）
STORAGE_DRIVER=local

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MinIO / 自建网关通常需要 true
S3_FORCE_PATH_STYLE=false
# 若用 CDN 回源，填公开访问前缀，例如 https://cdn.example.com/psd
S3_PUBLIC_BASE_URL=
