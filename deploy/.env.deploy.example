# =============================================================================
# PSD 展示台 · 推送服务器配置模板
#
#   cp deploy/.env.deploy.example deploy/.env.deploy
#   nano deploy/.env.deploy          # 填上你的服务器信息
#   bash deploy/scripts/deploy.sh --mode docker
#
# deploy/.env.deploy 已被 .gitignore 忽略，不会进仓库。
# =============================================================================

# ------------------------------ 目标服务器 ------------------------------
# 必填：服务器地址（IP 或域名）
DEPLOY_HOST=203.0.113.10
# 登录用户，建议用有 sudo 权限的普通用户而不是 root
DEPLOY_USER=deploy
# SSH 端口
DEPLOY_PORT=22
# 私钥路径（留空则用 ssh-agent / 默认 ~/.ssh/id_*）
SSH_KEY=

# 服务器上的部署根目录
DEPLOY_PATH=/opt/psd-hub

# ------------------------------ 部署模式 ------------------------------
# docker = 服务器上 docker compose 构建并启动（推荐，环境隔离干净）
# pm2    = 本地构建产物 rsync 上去 + pm2 reload（无 Docker 的轻量 VPS）
DEPLOY_MODE=docker

# ------------------------------ 应用参数 ------------------------------
APP_PORT=4000
# 健康检查地址（默认打 http://127.0.0.1:$APP_PORT/api/health，走 SSH 在服务器上执行）
HEALTH_PATH=/api/health
# 健康检查重试次数与间隔（秒）
HEALTH_RETRIES=15
HEALTH_DELAY=2

# pm2 模式：进程名（对应 deploy/pm2/ecosystem.config.cjs 里的 name）
PM2_APP_NAME=psd-hub
# pm2 模式：远端环境变量文件（由你手工创建，含令牌等机密）
REMOTE_ENV_FILE=/etc/psd-hub/psd-hub.env

# docker 模式：镜像名与标签
PSD_HUB_IMAGE=psd-hub
PSD_HUB_VERSION=1.0.0

# ------------------------------ 保留策略 ------------------------------
# pm2 模式保留的历史 release 目录数量
KEEP_RELEASES=5

# ------------------------------ 构建开关 ------------------------------
# 1 = 部署前在本地跑一遍 typecheck + 测试（更稳，但更慢）
RUN_TESTS_BEFORE_DEPLOY=1
